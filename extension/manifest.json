{
  "manifest_version": 3,
  "name": "TruthGuard",
  "version": "1.1.1",
  "description": "TruthGuard: an explainable AI browser extension that analyzes text for misinformation risk and shows why, using a local ML backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthGuard"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
